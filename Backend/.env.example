# Server Port
PORT=5000
NODE_ENV=production

# Database Configuration (Individual credentials or single DATABASE_URL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=Hr_Analytics
DB_SSL=false

# Or provide a single cloud MySQL connection URI (Aiven, PlanetScale, Railway, Render, etc.):
# DATABASE_URL=mysql://user:password@host:port/dbname?ssl-mode=REQUIRED

# JWT Authentication Secret
SECRET_KEY=your_super_secret_jwt_key_here

# Allowed Frontend Origins for CORS (comma-separated, e.g. https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173,http://localhost:3000
